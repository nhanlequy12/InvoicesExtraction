# ==============================================================================
# AI SMART INVOICE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment
APP_ENV=development
APP_NAME="AI Smart Invoice Processing Platform"
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_invoice_db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage (MinIO / AWS S3)
STORAGE_TYPE=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=smart-invoices
MINIO_SECURE=false

# Ingestion Settings
EMAIL_IMAP_SERVER=imap.example.com
EMAIL_IMAP_PORT=993
EMAIL_USERNAME=invoices@company.com
EMAIL_PASSWORD=secure-password-here
EMAIL_POLL_INTERVAL_SECONDS=60

# External Tax Verification Service (GDT / General Department of Taxation mock/API)
TAX_API_BASE_URL=https://api.gdt.gov.vn/v1
TAX_API_KEY=mock-tax-api-token
TAX_API_TIMEOUT_SECONDS=5.0

# ERP Export Configuration
ERP_ADAPTER=misa
ERP_ENDPOINT=https://api.erp.company.internal/v1
ERP_AUTH_TOKEN=enterprise-erp-token

# Pipeline Thresholds
CONFIDENCE_THRESHOLD_AUTO_APPROVE=0.92
CONFIDENCE_THRESHOLD_MANUAL_REVIEW=0.75
ARITHMETIC_TOLERANCE_VND=1.00
